#!/usr/bin/env bash
# Dump card project + Caderno + media → olie/cards/<CODE>/*.md
# Problema: implementation pedia ao agente MCP get-project/notebook/media.
# Manager dispara isto; o agente só lê os markdown.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="$ROOT/lib/olie_card_dump.py"

usage() {
    cat <<'EOF'
workvm-olie-card-dump — salva spec do card em markdown

  workvm-olie-card-dump --code <CODE> [--cards-root DIR]

Default cards-root: ~/git/olie/cards
Saída: <cards-root>/<CODE>/{README,project,media}.md + notebook/
EOF
}

code=""
cards_root="${HOME}/git/olie/cards"

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --code) code="${2:-}"; shift 2 ;;
        --cards-root) cards_root="${2:-}"; shift 2 ;;
        *)
            echo "arg desconhecido: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [ -z "$code" ]; then
    echo "uso: --code <CODE>" >&2
    exit 1
fi

# Load tokens into env for the Python helper
set -a
for conf in "${HOME}/.config/environment.d/"*.conf; do
    [ -f "$conf" ] || continue
    # shellcheck disable=SC1090
    . "$conf"
done
set +a

exec python3 "$PY" --code "$code" --cards-root "$cards_root"
