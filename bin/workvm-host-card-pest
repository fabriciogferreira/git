#!/usr/bin/env bash
# Pest no host-card Olie com env de teste da WorkVM.
# Problema: o ensure injeta MANAGEMENT_URL com slug do card e o secret
# reCAPTCHA de teste do Google — a suite espera *.olie.localhost e
# invalid_token para token fake. Sem este wrapper, ~3 testes falham.
# Problema (2026-11-16): no jarvis nproc=24; --processes≥23 mata workers
# com SIGSEGV (exit 139). Default teto 22; override WORKVM_HOST_CARD_PEST_PROCESSES.
# Problema (2026-11-23): artisan test rejeita --ci ("option does not exist");
# compose do card/sandbox pode ter PEST_TIA_LOCALLY=1, que encolhe a suite
# sem --ci. Regressão: não passar --ci; forçar PEST_TIA_LOCALLY=0 no exec.
# Problema (2026-11-24): --recreate-databases + rm dos migration-checksum_*.txt
# a cada run forçava migrate:fresh × N workers (~20 min). Default: reusa DBs
# + warm de checksum (olie/sandbox/host-card-pest-db.sh). Opt-in recreate:
# passe --recreate-databases nos args extras.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/host-card.sh
source "$ROOT/lib/host-card.sh"
# shellcheck source=../olie/sandbox/host-card-pest-db.sh
source "$ROOT/olie/sandbox/host-card-pest-db.sh"

usage() {
    cat <<'EOF'
workvm-host-card-pest — Pest no stack do host-card (Olie)

  workvm-host-card-pest --project olie --code <CODE> [--] [args do artisan test…]

Defaults: --compact --parallel --processes=min(nproc,22)
  (sem --recreate-databases: reusa testing_* + checksums; ~2 min no jarvis)
  (teto 22: ≥23 segfaulta no jarvis; override WORKVM_HOST_CARD_PEST_PROCESSES)
  (não passa --ci: artisan rejeita; TIA off via PEST_TIA_LOCALLY=0 no exec)
  Opt-in frio: passe --recreate-databases (aí o wrapper apaga checksums)
Env forçado no container (não muda o compose do browser):
  DB_DATABASE=<testing_* do card> (shared MySQL; default testing_<slug>)
  APP_ENV=testing
  MANAGEMENT_URL=http://{subdomain}.olie.localhost
  RECAPTCHA_SECRET=host-card-pest-rejects-invalid-tokens
  PEST_TIA_LOCALLY=0  (suite completa; TIA fica no sandbox / path-scoped)

Ex.:
  workvm-host-card-pest --project olie --code DOP-1183
  workvm-host-card-pest --project olie --code DOP-1183 -- --filter=ShowOfferOrder
  workvm-host-card-pest --project olie --code DOP-1183 -- --recreate-databases
EOF
}

project=""
code=""
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --project)
            project="${2:-}"
            shift 2
            ;;
        --code)
            code="${2:-}"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done

if [ "$project" != "olie" ] || [ -z "$code" ]; then
    workvm_host_card_log "uso: --project olie --code <CODE> [-- artisan test args…]"
    exit 1
fi

id="$(workvm_host_card_id "$project" "$code")"
meta="$(workvm_host_card_meta_path "$project" "$id")"
if [ ! -f "$meta" ]; then
    workvm_host_card_log "card ausente: $id (rode ensure antes)"
    exit 1
fi

compose_dir="$(python3 -c "import json;print(json.load(open('$meta')).get('compose_dir') or '')")"
pname="$(python3 -c "import json;print(json.load(open('$meta')).get('compose_project') or '')")"
testing_db="$(python3 -c "import json;print(json.load(open('$meta')).get('testing_database') or '')")"
api_worktree="$(python3 -c "import json;print(json.load(open('$meta')).get('api_worktree') or '')")"
if [ -z "$compose_dir" ] || [ ! -d "$compose_dir" ]; then
    compose_dir="$(workvm_host_card_dir "$project" "$id")/compose"
fi
if [ -z "$pname" ]; then
    pname="hc-${id}"
fi
if [ -z "$testing_db" ]; then
    testing_db="testing"
fi
if [ -z "$api_worktree" ]; then
    api_worktree="$(workvm_host_card_dir "$project" "$id")/worktree"
fi
# Host-card worktree root holds clones (api-main, …).
if [ -d "${api_worktree}/api-main" ]; then
    api_main="${api_worktree}/api-main"
else
    api_main="$api_worktree"
fi

nproc_count="$(nproc)"
default_procs="$nproc_count"
if [ "$nproc_count" -gt 22 ]; then
    default_procs=22
fi
procs="${WORKVM_HOST_CARD_PEST_PROCESSES:-$default_procs}"

# Strip Pest-only TIA flags: Laravel artisan test rejects --ci / --no-tia.
raw_extra=("$@")
extra=()
for a in "${raw_extra[@]+"${raw_extra[@]}"}"; do
    case "$a" in
        --ci|--no-tia) ;;
        *) extra+=("$a") ;;
    esac
done
if [ ${#extra[@]} -eq 0 ]; then
    # Sem --recreate-databases: FastRefresh reusa schema+checksum (gate ~2 min).
    extra=(--compact --parallel --processes="$procs")
fi

has_recreate=0
for a in "${extra[@]}"; do
    case "$a" in
        --recreate-databases) has_recreate=1 ;;
    esac
done

workvm_host_card_log "pest $id ($pname) → ${extra[*]} (PEST_TIA_LOCALLY=0)"

(
    cd "$compose_dir"
    set -a
    # shellcheck disable=SC1091
    source .env
    set +a
    export COMPOSE_PROJECT_NAME="$pname"
    docker compose --profile slim exec -T app mkdir -p /tmp/pest-hc

    if [ "$has_recreate" -eq 1 ]; then
        # --recreate-databases esvazia o MySQL; checksum igual faria pular
        # migrate:fresh → 0 tables. Só apaga checksums nesse caminho frio.
        docker compose --profile slim exec -T app \
            sh -c 'rm -f storage/app/migration-checksum_*.txt'
    else
        workvm_olie_host_card_pest_warm "$compose_dir" "$pname" "$testing_db" "$procs" "$api_main" || true
    fi

    # -e no exec: workers do --parallel herdam o env do PHP pai.
    # PEST_TIA_LOCALLY=0: artisan não aceita --ci; env desliga TIA even if
    # compose still sets PEST_TIA_LOCALLY=1 (sandbox / slim host-card).
    docker compose --profile slim exec -T \
        -e TMPDIR=/tmp/pest-hc \
        -e DB_DATABASE="$testing_db" \
        -e APP_ENV=testing \
        -e MANAGEMENT_URL='http://{subdomain}.olie.localhost' \
        -e RECAPTCHA_SECRET='host-card-pest-rejects-invalid-tokens' \
        -e PEST_TIA_LOCALLY=0 \
        app \
        php -d memory_limit=2G artisan test "${extra[@]}"
)
