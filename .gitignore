# Ignora tudo por padrão
*

# Não ignora estas pastas/arquivos
!.gitignore
!README.md
!HISTORICO.md
!project-setup.sh
!vm-setup.sh
!vm.local.conf.example
!.shellcheckrc
# Nome e e-mail desta máquina — não versionar
vm.local.conf
!bin/
!bin/**
!lib/
!lib/**
!projects/
!projects/**
!systemd/
!systemd/**
!code-profiles/
!code-profiles/**
!.config/
!.config/**
!.cursor/
!.cursor/**
!prompts/
!prompts/**
!mcps/
!mcps/**
# Secrets locais de sessão (OLIE_FLOW_AI_TOKEN etc.) — nunca versionar
.config/environment.d/*.conf
# Local compose secrets / machine-specific overrides
projects/**/.env
# Marker do stub MCP (servidores em ~/.cursor/mcp.json); local da VM
projects/**/.cursor/mcp.workvm-user

# Clones em olie/ e televisao/ ficam de fora. O e2e local mora em projects/.
# Gerado por project-setup (projeto desta VM); não versionar
.cursor/rules/workvm-project.mdc
# Cópia do MCP do projeto setado (fonte em mcps/)
.cursor/mcp.json
