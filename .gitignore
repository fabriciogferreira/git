# locav: definição + prompts + overlay; clones LocavApi / locav-front ficam fora.
!locav/
locav/*
!locav/README.md
!locav/project.conf
!locav/post-clone.sh
!locav/start.hook.sh
!locav/workspace.code-workspace
!locav/config-vm.xml
!locav/prompts/
!locav/prompts/**
!locav/overlay/
!locav/overlay/**
