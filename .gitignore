# Ignora tudo por padrão
*

# Não ignora estas pastas/arquivos
!.gitignore
!README.md
!HISTORICO.md
!project-setup.sh
!vm-setup.sh
!vm.local.conf.example
!.shellcheckrc
# Nome e e-mail desta máquina — não versionar
vm.local.conf
!bin/
!bin/**
!lib/
!lib/**
!projects/
!projects/**
!systemd/
!systemd/**
!code-profiles/
!code-profiles/**
!.config/
!.config/**
!.cursor/
!.cursor/**
!mcps/
!mcps/**
!life.md
!host-setup.md
# Secrets locais de sessão (OLIE_FLOW_AI_MCP_TOKEN, OLIE_MANAGEMENT_TOKEN etc.) — nunca versionar
.config/environment.d/*.conf
# Local compose secrets / machine-specific overrides
projects/**/.env
olie/**/.env
# Marker do stub MCP (servidores em ~/.cursor/mcp.json); local da VM
projects/**/.cursor/mcp.workvm-user
olie/**/.cursor/mcp.workvm-user

# Clones em olie/<repo>/ ficam de fora. Definição do projeto + e2e + overlay versionados.
!olie/
olie/*
!olie/README.md
!olie/project.conf
!olie/post-clone.sh
!olie/workspace.code-workspace
!olie/docker-compose.yml
!olie/.env.example
!olie/api-main.vscode.settings.json
!olie/docker/
!olie/docker/**
!olie/overlay/
!olie/overlay/**
!olie/olie-e2e/
!olie/olie-e2e/**
!olie/cards/
!olie/cards/*/
!olie/cards/*/*.md
!olie/prompts/
!olie/prompts/**
!olie/config-vm.xml

# vid2agent-code: definição + prompts; clone em vid2agent-code/vid2agent-code/ fica fora.
!vid2agent-code/
vid2agent-code/*
!vid2agent-code/README.md
!vid2agent-code/project.conf
!vid2agent-code/post-clone.sh
!vid2agent-code/workspace.code-workspace
!vid2agent-code/prompts/
!vid2agent-code/prompts/**

# opbed: definição do projeto; clones em opbed/opbed-backend|frontend ficam fora.
!opbed/
opbed/*
!opbed/README.md
!opbed/project.conf
!opbed/post-clone.sh
!opbed/workspace.code-workspace

# televisao: definição + e2e; clones televisao-api|front|meet-* ficam fora.
!televisao/
televisao/*
!televisao/README.md
!televisao/project.conf
!televisao/post-clone.sh
!televisao/workspace.code-workspace
!televisao/config-vm.xml
!televisao/prompts/
!televisao/prompts/**
!televisao/cards/
!televisao/cards/*/
!televisao/cards/*/*.md
!televisao/overlay/
!televisao/overlay/**
!televisao/televisao-front-e2e/
!televisao/televisao-front-e2e/**
!televisao/televisao-meet-front-e2e/
!televisao/televisao-meet-front-e2e/**
televisao/**/.env
televisao/**/.cursor/mcp.workvm-user

