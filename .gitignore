# Ignora tudo por padrão
*

# Não ignora estas pastas/arquivos
!.gitignore
!README.md
!tasks.md
!project-setup.sh
!vm-setup.sh
!workvm/
!workvm/**
!code-profiles/
!code-profiles/**
!files/
!files/**
!.config/
!.config/**
# Local compose secrets / machine-specific overrides
workvm/projects/**/.env

# Reativa pastas pais (com * no topo o Git não desce em dirs ignorados)
!olie/
!olie/olie-e2e/
!olie/olie-e2e/**
!televisao/
!televisao/televisao-front-e2e/
!televisao/televisao-front-e2e/**
!televisao/televisao-meet-front-e2e/
!televisao/televisao-meet-front-e2e/**
# Rules da VM ficam em workvm/.cursor (não em ~/git/.cursor)
# Gerado por project-setup (projeto desta VM); não versionar
workvm/.cursor/rules/workvm-project.mdc
