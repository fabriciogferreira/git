# Sandbox backend: Bun + real Node for Vitest workers / coverage.
# Problema: oven/bun só publica `node` via fallback → bun; Vitest --coverage
# (pool forks/threads) quebra com `child.channel?.unref is not a function`.
# Não altera a imagem do Card (compose.host / oven/bun puro).

FROM oven/bun:1.3.5-slim

USER root

ARG NODE_VERSION=22.22.0

RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
	&& ARCH="$(dpkg --print-architecture)" \
	&& case "$ARCH" in \
		amd64) NODE_ARCH=x64 ;; \
		arm64) NODE_ARCH=arm64 ;; \
		*) echo "unsupported arch: $ARCH" >&2; exit 1 ;; \
	esac \
	&& curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
		| tar -xJ -C /usr/local --strip-components=1 \
	&& apt-get purge -y curl xz-utils \
	&& apt-get autoremove -y \
	&& rm -rf /var/lib/apt/lists/* \
	&& node -v \
	&& npm -v \
	&& bun -v \
	&& test "$(readlink -f "$(command -v node)")" != "$(readlink -f "$(command -v bun)")"

# Compose sets user: HOST_UID:HOST_GID; keep root default in the image.
