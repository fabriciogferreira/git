# Bun + real Node for Vitest workers / coverage / Stryker.
# Problema: oven/bun só publica `node` via fallback → bun; Vitest
# (pool forks/threads, coverage, pre-deploy `bun run test`) quebra com
# `child.channel?.unref is not a function`.
# Stryker também precisa de `ps` (procps) para matar workers; sem isso
# o dry-run passa e o mutate morre com `spawn ps ENOENT`.
# Usada no sandbox slim e no serviço `lib` do compose.host (host-card).

FROM oven/bun:1.3.5-slim

USER root

ARG NODE_VERSION=22.22.0

RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates curl xz-utils procps \
	&& ARCH="$(dpkg --print-architecture)" \
	&& case "$ARCH" in \
		amd64) NODE_ARCH=x64 ;; \
		arm64) NODE_ARCH=arm64 ;; \
		*) echo "unsupported arch: $ARCH" >&2; exit 1 ;; \
	esac \
	&& curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
		| tar -xJ -C /usr/local --strip-components=1 \
	&& apt-get purge -y curl xz-utils \
	&& apt-get autoremove -y \
	&& rm -rf /var/lib/apt/lists/* \
	&& node -v \
	&& npm -v \
	&& bun -v \
	&& command -v ps >/dev/null \
	&& test "$(readlink -f "$(command -v node)")" != "$(readlink -f "$(command -v bun)")"

# Compose sets user: HOST_UID:HOST_GID; keep root default in the image.
