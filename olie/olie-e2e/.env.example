# Optional — defaults match api-main local seed (tester@olie.ai / password).
# Only set these to override.

# E2E_BASE_URL=http://devframe.olie.localhost
# E2E_API_URL=http://api.olie.localhost
# E2E_USER=tester@olie.ai
# E2E_PASSWORD=password

# Parallel workers (default 3). Use 1 for the full suite on the shared seed user.
# E2E_WORKERS=3

# Internal docker hostnames (e2e container → api / mailhog). Override only if needed.
# E2E_API_INTERNAL=http://olie-api-main:8080
# E2E_MAIL_INTERNAL=http://olie-mailhog:8025
# E2E_APP_HOST=olie.localhost
