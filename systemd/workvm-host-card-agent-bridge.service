# Cursor agent sandbox hides docker.sock / ~/.cursor; ensure/docker exec from
# chat can fail even after required_permissions all is "auto-approved" without
# elevation. This user service polls worktree request files and runs them on
# the host (ensure + card-scoped docker exec).
[Unit]
Description=WorkVM host-card agent bridge (ensure + docker, outside Cursor sandbox)
After=default.target

[Service]
Type=simple
ExecStart=%h/git/bin/workvm-host-card-agent-bridge
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
