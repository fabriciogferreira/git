[Unit]
Description=WorkVM project startup
Documentation=file://%h/git/projects
After=graphical-session.target workvm-git-pull.service
Wants=workvm-git-pull.service
PartOf=graphical-session.target


[Service]
Type=oneshot
RemainAfterExit=yes
KillMode=process
ExecStart=%h/git/lib/project-start.sh %h/.config/workvm/current
# Session env is also repaired inside project-start.sh / common.sh
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=graphical-session.target
