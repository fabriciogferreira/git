# No login gráfico: compose, Cursor e browser do projeto em current.
# WantedBy=default.target — graphical-session.target tem RefuseManualStart e
# SDDM+start-hyprland nunca o ativam; default.target sobe com a sessão do usuário.
[Unit]
Description=WorkVM project startup
Documentation=file://%h/git/projects
After=workvm-git-pull.service
Wants=workvm-git-pull.service

[Service]
Type=oneshot
RemainAfterExit=yes
KillMode=process
ExecStart=%h/git/lib/project-start.sh %h/.config/workvm/current
# Session env is also repaired inside project-start.sh / common.sh
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=default.target
