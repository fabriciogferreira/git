# git pull --ff-only do meta-repo no login do usuário.
# Só na branch de origin (main). Falha de rede/divergência não derruba a sessão.
# Mesmo WantedBy que workvm.service — ver comentário lá sobre graphical-session.
[Unit]
Description=WorkVM meta-repo git pull --ff-only (~/git, branch main)
Documentation=file://%h/git/vm-setup.sh

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=90
ExecStart=%h/git/bin/pull-meta.sh
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=default.target
