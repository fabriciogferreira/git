# Imagem API do host-card Televisão.
# Problema: o Dockerfile da empresa falha no stage composer (imagem
# composer:2 sem ext-bcmath). Aqui ignora platform reqs no install;
# as extensions reais entram no stage php (igual ao clone).
# context de build = clone televisao-api.

FROM composer:2.10.1 AS composer

ENV COMPOSER_ALLOW_SUPERUSER=1

WORKDIR /app

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --no-scripts \
    --no-progress \
    --no-autoloader \
    --ignore-platform-reqs

COPY . .

RUN composer dump-autoload --optimize --classmap-authoritative --no-scripts --ignore-platform-reqs

FROM php:8.4-cli-alpine AS php

ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_HOME=/tmp/composer

RUN apk add --no-cache \
    bash \
    curl \
    postgresql-client \
    ffmpeg \
    python3

COPY --from=composer /usr/bin/composer /usr/bin/composer

RUN curl -sSLf -o /usr/local/bin/install-php-extensions \
  https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions \
  && chmod +x /usr/local/bin/install-php-extensions \
  && install-php-extensions \
  pdo_pgsql \
  intl \
  bcmath \
  redis \
  zip \
  gd \
  pcntl \
  && rm -f /usr/local/bin/install-php-extensions

WORKDIR /srv

COPY --from=composer /app /srv

COPY --chown=www-data:www-data . /srv

RUN mkdir -p \
    storage/framework/sessions \
    storage/framework/views \
    storage/framework/cache/data \
    storage/framework/testing \
    bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

FROM php AS api

COPY --from=php /usr/bin/composer /usr/bin/composer

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000

# setup.sh no compose (composer no volume montado + migrate + serve)
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
