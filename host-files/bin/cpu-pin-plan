#!/usr/bin/env bash
# Discover host CPU topology and print pin / cgroup plan for a gaming guest.
# Problem: Arch wiki samples hardcode AllowedCPUs=0,1,6,7 — wrong on another PC.
# Re-run on every machine (or after CPU change) before installing the libvirt hook.
#
# Usage:
#   HOST_P_CORES=2 ./cpu-pin-plan           # default: 2 P-cores for host, rest P → guest; E → host
#   HOST_P_CORES=2 ./cpu-pin-plan --xml      # also emit libvirt <cputune> / <cpu> sketch
#   HOST_P_CORES=2 ./cpu-pin-plan --write /tmp/cpu-pin.env

set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=cpu-pin-lib.sh
source "$here/cpu-pin-lib.sh"

do_xml=0
out_env=
while (($#)); do
  case $1 in
    --xml) do_xml=1; shift ;;
    --write) out_env=$2; shift 2 ;;
    -h|--help)
      sed -n '2,12p' "$0"
      exit 0
      ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

cpu_plan

model=$(lscpu | awk -F: '/Model name/{gsub(/^[ \t]+/,"",$2); print $2; exit}')
echo "model:        $model"
echo "HOST_P_CORES: ${HOST_P_CORES:-2}  (physical P-cores left for host while guest runs)"
echo "P_CPUS:       $P_CPUS"
echo "E_CPUS:       ${E_CPUS:-(none)}"
echo "HOST_P:       $HOST_P_THREADS"
echo "HOST_ALLOWED: $HOST_ALLOWED   ← systemctl AllowedCPUs while guest up"
echo "GUEST_CPUS:   $GUEST_CPUS     ← vcpupin / cpuset for the domain ($GUEST_N threads)"
echo "ALL_CPUS:     $ALL_CPUS       ← restore on guest release"
echo
echo "Inspect: lscpu -e && lstopo"
echo "Hybrid sysfs: /sys/devices/cpu_core/cpus  /sys/devices/cpu_atom/cpus"

if [[ -n $out_env ]]; then
  cat >"$out_env" <<EOF
# Generated by cpu-pin-plan — do not edit by hand; regenerate on new hardware.
HOST_ALLOWED=$HOST_ALLOWED
ALL_CPUS=$ALL_CPUS
GUEST_CPUS=$GUEST_CPUS
HOST_P_CORES=${HOST_P_CORES:-2}
EOF
  echo
  echo "wrote $out_env"
fi

if ((do_xml)); then
  echo
  echo "--- paste into domain (adapt name / iothread) ---"
  mapfile -t g < <(cpu_expand "$GUEST_CPUS")
  # topology: guest threads / 2 if even (HT), else 1 thread per core
  threads_per=2
  ((${#g[@]} % 2 == 0)) || threads_per=1
  cores=$((${#g[@]} / threads_per))
  echo "<vcpu placement='static'>${#g[@]}</vcpu>"
  echo "<cputune>"
  i=0
  for cpu in "${g[@]}"; do
    echo "  <vcpupin vcpu='$i' cpuset='$cpu'/>"
    i=$((i + 1))
  done
  mapfile -t h < <(cpu_expand "$HOST_P_THREADS")
  if ((${#h[@]} >= 2)); then
    echo "  <emulatorpin cpuset='${h[0]},${h[1]}'/>"
  elif ((${#h[@]} == 1)); then
    echo "  <emulatorpin cpuset='${h[0]}'/>"
  fi
  echo "</cputune>"
  echo "<cpu mode='host-passthrough' check='none'>"
  echo "  <topology sockets='1' dies='1' cores='$cores' threads='$threads_per'/>"
  echo "</cpu>"
fi
