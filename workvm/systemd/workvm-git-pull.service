[Unit]
Description=WorkVM meta-repo git fetch (~/git, branch main)
Documentation=file://%h/git/vm-setup.sh
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=90
ExecStart=%h/git/workvm/bin/pull-meta.sh
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=graphical-session.target
